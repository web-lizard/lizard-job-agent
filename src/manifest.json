{
  "manifest_version": 3,
  "name": "Lizard Job Agent",
  "version": "0.1.0",
  "description": "Безопасно заполняет открытые формы резюме данными из локального профиля.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://hh.ru/*", "https://*.hh.ru/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Lizard Job Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lizard-16.png",
      "32": "icons/lizard-32.png",
      "48": "icons/lizard-48.png",
      "96": "icons/lizard-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/lizard-16.png",
    "32": "icons/lizard-32.png",
    "48": "icons/lizard-48.png",
    "96": "icons/lizard-96.png",
    "128": "icons/lizard-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://hh.ru/*", "https://*.hh.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lizard-job-agent@web-lizard.local",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "115.0"
    }
  }
}
