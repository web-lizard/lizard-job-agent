{
  "name": "lizard-job-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode ui && vite build --mode content && vite build --mode background",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
